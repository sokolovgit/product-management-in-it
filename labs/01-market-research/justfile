SKILL := env_var('HOME') / '.claude/skills/kpi-lab-report'
REPORT := 'docs/report/report.md'

# Список доступних рецептів
default:
    @just --list

# Згенерувати шаблон стилів (потрібен один раз на проєкт)
reference:
    python3 {{SKILL}}/scripts/make_reference_docx.py docs/report/reference.docx

# Відрендерити блок-схему з блоку mermaid у звіті
diagram:
    python3 {{SKILL}}/scripts/render_diagram.py {{REPORT}}

# Зібрати звіт (ім'я для здачі: just report Прізвище_Ім'я_група_1.docx)
report *NAME:
    python3 {{SKILL}}/scripts/build_report.py {{REPORT}} {{NAME}}

# Зібрати звіт і розставити «Продовження таблиці N» за версткою Word (macOS + Word)
final *NAME:
    python3 {{SKILL}}/scripts/build_report.py {{REPORT}} {{NAME}}
    python3 {{SKILL}}/scripts/continue_tables.py "docs/report/{{ if NAME == "" { "report.docx" } else { NAME } }}"

# Змоделювати опитування, порахувати показники й перемалювати рисунки
data:
    python3 data/generate_survey.py
    uv run -q --with matplotlib python data/analyze_survey.py
    uv run -q --with matplotlib python data/figures.py
    python3 data/build_form_script.py
